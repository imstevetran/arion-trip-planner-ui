# The only config this app needs — every real secret lives in
# trip-planner-api, which this app calls over plain HTTP. Nothing else
# belongs in this repo.
VITE_TRIP_PLANNER_API_URL=http://localhost:4300

# NOT a real secret — Vite inlines this into the public JS bundle. It's a
# filter against scripted abuse of trip-planner-api, not access control; see
# src/lib/api.ts. Must match trip-planner-api's FRONTEND_API_SECRET exactly.
# Falls back to trip-planner-api's own local-dev default if unset.
VITE_TRIP_PLANNER_API_SECRET=local-dev-frontend-secret
